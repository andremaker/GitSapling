#!/usr/bin/env python3
"""Create configured shared-path links after a new worktree is added."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def git_output(*arguments: str) -> str:
    return subprocess.check_output(["git", *arguments], text=True).strip()


def main() -> int:
    if len(sys.argv) < 4:
        return 0

    old_revision, _, checkout_type = sys.argv[1:4]
    # Branch switches also pass 1; only worktree creation has an all-zero old revision.
    checkout_created_worktree = (
        checkout_type == "1" and old_revision and not old_revision.strip("0")
    )
    if not checkout_created_worktree:
        return 0

    current_worktree = Path(git_output("rev-parse", "--show-toplevel")).resolve()
    common_git_dir = Path(
        git_output("rev-parse", "--path-format=absolute", "--git-common-dir")
    )
    primary_worktree = common_git_dir.parent.resolve()
    if current_worktree == primary_worktree:
        return 0

    link_setup_script = Path(__file__).resolve().with_name("setup-worktree-links.py")
    os.execv(sys.executable, [sys.executable, str(link_setup_script), str(primary_worktree), str(current_worktree)])
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        print(f"worktree hook: {error}", file=sys.stderr)
        raise SystemExit(error.returncode)
